global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: 'development'
    project: 'product-template'

scrape_configs:
  - job_name: 'product-template-api'
    scrape_interval: 15s
    metrics_path: '/metrics'
    static_configs:
      - targets: ['api:8080']
        labels:
          service: 'api'
          team: 'backend'
    # MONITORING_HEADER_START
    http_headers:
      X-Monitoring-Api-Key:
        values: ['__MONITORING_API_KEY__']
    # MONITORING_HEADER_END

  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
